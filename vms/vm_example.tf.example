# module "vm_example" {
#   source = "../modules/vm"
#
#   name              = "vm-example"
#   vmid              = 110
#   target_node       = var.target_node
#   clone_template_id = 9001     # <-- Template ID langsung di sini
#
#   # Compute
#   cores   = 2
#   sockets = 1
#   memory  = 2048               # MB (2048 = 2GB, 4096 = 4GB)
#
#   # Storage Utama (scsi0)
#   # PERHATIAN: Kamu bisa MENAMBAH (expand) ukuran disk di kemudian hari.
#   # Namun, JANGAN PERNAH MENURUNKAN (shrink) ukuran disk karena tidak 
#   # disupport oleh Proxmox dan bisa menyebabkan error.
#   disk_size = 23               # 23GB minimum base size template
#   storage   = var.default_storage
#
#   # (Optional) Tambahan Disk
#   # additional_disks = [
#   #   {
#   #     datastore_id = "local-lvm"
#   #     size         = 50      # GB
#   #   },
#   #   {
#   #     datastore_id = "local-lvm"
#   #     size         = 100     # GB
#   #   }
#   # ]
#
#   # Network
#   bridge      = var.default_bridge
#   ip_address  = "[IP_ADDRESS]"
#   gateway     = var.gateway
#   dns_servers = var.dns_servers
#
#   # Cloud-Init                  <-- Credentials langsung di sini
#   ci_user        = "debian"
#   ci_password    = "[PASSWORD]"
#   ssh_public_key = var.ssh_public_key
#
#   # Metadata
#   description = "Example VM"
#   tags        = ["example", "homelab"]
# }
#
